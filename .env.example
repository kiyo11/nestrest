# ---- NestRest environment (Vercel + Neon) ----
# Copy to .env.local and fill in. Never commit real secrets.

# Neon Postgres — pooled connection for the app runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/nestrest?sslmode=require"
# Neon direct connection — used by Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/nestrest?sslmode=require"

# Auth.js (NextAuth v5)
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Optional Google OAuth (owner convenience)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend transactional email
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxx"
RESEND_WEBHOOK_SECRET="whsec_xxxxxxxxxxxx"
EMAIL_FROM="NestRest <noreply@yourdomain.com>"

# AES-256-GCM key for PII encryption — 32 bytes, base64 (openssl rand -base64 32)
ENCRYPTION_KEY="base64-32-byte-key-here"

# Validates Vercel Cron calls (sent as Authorization: Bearer <CRON_SECRET>)
CRON_SECRET="generate-a-long-random-string"
